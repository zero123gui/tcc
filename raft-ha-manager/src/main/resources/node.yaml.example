# ==============================================================================
# Configuração do nó raft-ha-manager
#
# Copie este arquivo para o diretório de trabalho de cada VM e ajuste os
# valores de acordo com o nó que está sendo configurado.
#
# Exemplo para 5 nós:
#   vm-node-1: node-id: "node-1", grpc-address: "192.168.10.101:9090", arbiter: false
#   vm-node-2: node-id: "node-2", grpc-address: "192.168.10.102:9090", arbiter: false
#   vm-node-3: node-id: "node-3", grpc-address: "192.168.20.103:9090", arbiter: false
#   vm-node-4: node-id: "node-4", grpc-address: "192.168.20.104:9090", arbiter: false
#   vm-node-5: node-id: "node-5", grpc-address: "192.168.10.105:9090", arbiter: true
# ==============================================================================

# Identificador único deste nó no cluster. Deve ser imutável após a primeira
# inicialização, pois é usado como chave nos logs e no estado persistido.
node-id: "node-1"

# Endereço em que o servidor gRPC deste nó vai escutar.
# Formato: host:porta. Use o IP da interface de rede da VM, não 127.0.0.1,
# pois os outros nós precisam alcançar este endereço.
grpc-address: "192.168.10.101:9090"

# Se true, este nó participa das votações Raft mas não hospeda PostgreSQL.
# Árbitros são leves (sem banco de dados) e servem apenas como desempatador.
# Os nós árbitros nunca se tornam Primary do PostgreSQL.
arbiter: false

# ==============================================================================
# Configuração do PostgreSQL local
# Ignorado completamente se arbiter=true
# ==============================================================================
postgres:
  host: "127.0.0.1"
  port: 5432
  database: "postgres"
  user: "postgres"
  password: "senha_aqui"

  # Caminho para o diretório de dados do PostgreSQL.
  # Usado pelo FailoverExecutor para executar pg_ctl promote.
  # Exemplo Ubuntu: /var/lib/postgresql/16/main
  data-dir: "/var/lib/postgresql/16/main"

  # Intervalo em milissegundos entre cada verificação de saúde do PostgreSQL.
  # Deve ser menor que election-timeout-min-ms para detectar falhas a tempo.
  health-check-interval-ms: 3000

  # Número de falhas consecutivas na verificação de saúde antes de declarar
  # o PostgreSQL local como indisponível e notificar o cluster.
  # Evita falsos positivos por latência momentânea.
  health-check-failure-threshold: 3

# ==============================================================================
# Configuração do algoritmo Raft
# ==============================================================================
raft:
  # Intervalo de heartbeat em milissegundos. O líder envia AppendEntries
  # vazio para todos os seguidores neste intervalo.
  # Deve ser significativamente menor que election-timeout-min-ms.
  heartbeat-interval-ms: 5000

  # Tempo mínimo e máximo de espera antes de iniciar uma eleição.
  # O jitter aleatório dentro deste intervalo evita que todos os seguidores
  # iniciem eleições simultaneamente após a queda do líder.
  #
  # Para ambientes de produção com redes estáveis, valores de 15-30s são
  # recomendados para evitar failovers por falhas transitórias de rede.
  # Para testes em laboratório, valores de 8-15s tornam o comportamento
  # mais fácil de observar.
  election-timeout-min-ms: 15000
  election-timeout-max-ms: 30000

  # Timeout para chamadas gRPC entre pares (RequestVote e AppendEntries).
  # Se um par não responder dentro deste tempo, a chamada é tratada como falha.
  rpc-timeout-ms: 3000

  # Pré-votação (tese do Raft, seção 9.6). Antes de se candidatar, o nó pergunta
  # aos outros se votariam nele, sem subir o próprio mandato. Quem ouviu o líder
  # há menos de election-timeout-min-ms responde que não. Assim, um nó que volta
  # ao cluster depois de ficar fora não derruba um líder que está funcionando.
  # Padrão: true. Use false só para experimentos comparativos.
  pre-vote: true

  # Check-quorum (tese do Raft, seção 6.2). O líder renuncia se ficar mais de
  # election-timeout-min-ms sem resposta da maioria do cluster (ex.: partição de
  # rede), em vez de continuar se declarando líder.
  # Padrão: true. Use false só para experimentos comparativos.
  check-quorum: true

# ==============================================================================
# Persistência do estado Raft
# ==============================================================================
storage:
  # Diretório onde o log Raft e o estado persistido serão armazenados.
  # O raft-ha-manager cria os arquivos raft-log.jsonl e raft-state.json aqui.
  # O diretório deve existir e o processo deve ter permissão de escrita.
  log-dir: "/var/lib/raft-ha-manager"

# ==============================================================================
# Lista de todos os nós do cluster
# Todos os nós devem ter a mesma lista (mesma configuração de cluster).
# Esta lista é o ponto de entrada inicial. Após mudanças de configuração
# via CONFIG_CHANGE, a lista atual é mantida no estado do RaftNode.
# ==============================================================================
peers:
  - id: "node-1"
    grpc-address: "192.168.10.101:9090"
    arbiter: false

  - id: "node-2"
    grpc-address: "192.168.10.102:9090"
    arbiter: false

  - id: "node-3"
    grpc-address: "192.168.20.103:9090"
    arbiter: false

  - id: "node-4"
    grpc-address: "192.168.20.104:9090"
    arbiter: false

  # Árbitro: sem PostgreSQL, apenas participa das votações
  - id: "node-5"
    grpc-address: "192.168.10.105:9090"
    arbiter: true
